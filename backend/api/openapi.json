{
  "openapi": "3.0.1",
  "info": {
    "title": "Mountain hut",
    "description": "REST APIs for the interaction with the service.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3001/"
    }
  ],
  "paths": {
     "/api/auth/signup": {
      "post": {
        "summary": "Sign up as a hiker",
        "description": "Creates a new user with role hiker and logs them in (sets the session cookie). The role cannot be chosen by the client.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hiker created and logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Log in",
        "description": "Same endpoint for hikers, employees and wardens. On success the session cookie is set.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Email or password incorrect",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Log out",
        "responses": {
          "200": {
            "description": "Logged out, session destroyed"
          }
        }
      }
    },
    "/api/auth/user": {
      "get": {
        "summary": "Get the logged-in user",
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/warden/employees": {
      "post": {
        "summary": "Create an employee",
        "description": "Only a warden can create employees. The warden stays logged in as warden.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Employee created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/tables": {
      "get": {
        "summary": "List all the tables",
        "responses": {
          "200": {
            "description": "List of tables ordered by number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Table"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "summary": "Create a new table",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TableInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Table created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Table"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "Table number already exists"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/tables/{table_id}": {
      "parameters": [
        {
          "name": "table_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "summary": "Modify existing table",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TableInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Table updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Table"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Table not found"
          },
          "409": {
            "description": "Table number already exists"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "delete": {
        "summary": "Delete a table",
        "responses": {
          "204": {
            "description": "Table deleted successfully (No Content returned)"
          },
          "400": {
            "description": "Cannot delete a table that is scheduled in a slot or has active reservations"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Table not found"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/slots/{slot_id}/availability": {
      "get": {
        "summary": "check availability during a slot",
        "parameters": [
          {
            "name": "slot_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "partySize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Availability check successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "available": {
                      "type": "boolean"
                    },
                    "totalAvailableSeats": {
                      "type": "integer"
                    },
                    "availableTables": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "table_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "number": {
                            "type": "string"
                          },
                          "remainingSeats": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Insufficient seats available for this party size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No tables are assigned to this slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "description": "Requires an authenticated user."
      }
    },
    "/api/slots/{slot_id}/reservations": {
      "post": {
        "summary": "Create a new reservation for a slot",
        "parameters": [
          {
            "name": "slot_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reservation created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
           "400": {
            "description": "Insufficient seats for the party size, less than 2 hours before the slot starts, or no tables assigned to the slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Slot not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The hiker already has a reservation for this slot, or the slot was being booked concurrently (retry)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "description": "Only hikers can book. The party is seated at one table if possible, otherwise over the fewest tables."
      }
    }
  },
  "components": {
    "schemas": {
       "SignupInput": {
        "type": "object",
        "required": [
          "name",
          "surname",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50,
            "example": "Anna"
          },
          "surname": {
            "type": "string",
            "maxLength": 50,
            "example": "Bianchi"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "anna@example.com"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "+393331234567"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128,
            "example": "password123"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "warden@rifugio.it"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Password123!"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "anna@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "hiker",
              "employee",
              "warden"
            ],
            "example": "hiker"
          }
        }
      },
      "TableInput": {
        "type": "object",
        "required": [
          "number",
          "seats"
        ],
        "properties": {
          "number": {
            "type": "string",
            "example": "T1"
          },
          "seats": {
            "type": "integer",
            "example": 4
          }
        }
      },
      "ReservationInput": {
        "type": "object",
        "required": [
          "people"
        ],
        "properties": {
          "people": {
            "type": "integer",
            "example": 4
          }
        }
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "reservation_id": {
            "type": "string",
            "format": "uuid"
          },
          "people": {
            "type": "integer",
            "example": 4
          },
          "slot_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "table_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "number": {
                  "type": "string",
                  "example": "T1"
                },
                "seats_reserved": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "Table": {
        "type": "object",
        "properties": {
          "table_id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "string",
            "example": "T1"
          },
          "seats": {
            "type": "integer",
            "example": 4
          }
        }
      },
       "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Slot not found"
          }
        }
      },
      "MessageError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Unauthorized (user is not logged in)"
          }
        }
      },
      "ValidationErrors": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "people"
                },
                "message": {
                  "type": "string",
                  "example": "people must be a positive integer"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Not logged in",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Logged in, but the role is not allowed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageError"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Invalid request parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrors"
            }
          }
        }
      }
    }
  }
}