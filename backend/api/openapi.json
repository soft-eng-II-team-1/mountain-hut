{
  "openapi": "3.0.1",
  "info": {
    "title": "Mountain hut",
    "description": "REST APIs for the interaction with the service.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3001/"
    }
  ],
  "paths": {
    "/api/auth/signup": {
      "post": {
        "summary": "Sign up as a hiker",
        "description": "Creates a new user with role hiker and logs them in (sets the session cookie). The role cannot be chosen by the client.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hiker created and logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Log in",
        "description": "Same endpoint for hikers, employees and wardens. On success the session cookie is set.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Email or password incorrect",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Log out",
        "responses": {
          "200": {
            "description": "Logged out, session destroyed"
          }
        }
      }
    },
    "/api/auth/user": {
      "get": {
        "summary": "Get the logged-in user",
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/warden/employees": {
      "post": {
        "summary": "Create an employee",
        "description": "Only a warden can create employees. The warden stays logged in as warden.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Employee created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/tables": {
      "get": {
        "summary": "List all the tables",
        "responses": {
          "200": {
            "description": "List of tables ordered by number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Table"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "summary": "Create a new table",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TableInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Table created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Table"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "Table number already exists"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/tables/{table_id}": {
      "parameters": [
        {
          "name": "table_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "summary": "Modify existing table",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TableInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Table updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Table"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Table not found"
          },
          "409": {
            "description": "Table number already exists, the new seats are fewer than the seats reserved on the table in a slot that is not over, or the table is being modified concurrently"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "delete": {
        "summary": "Delete a table",
        "responses": {
          "204": {
            "description": "Table deleted successfully (No Content returned)"
          },
          "400": {
            "description": "Cannot delete a table that is scheduled in a slot or has active reservations"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Table not found"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/slots": {
      "get": {
        "summary": "List the slots (employee or warden), ordered by start time",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Only slots that end after this date-time",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Only slots that start before this date-time",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of slots with their tables and total seats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Slot"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "post": {
        "summary": "Create a slot with its tables (employee or warden)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SlotInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Slot created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Slot"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "description": "The slot overlaps an existing slot, or it is being modified concurrently",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
        "/api/slots/available": {
      "get": {
        "summary": "List the slots a hiker can book for a party in a time range (any logged-in user)",
        "description": "Returns the slots that start in [from, to), start at least 2 hours from now and have at least partySize free seats, ordered by start time. ",
        "parameters": [
          {
            "name": "partySize",
            "in": "query",
            "required": true,
            "description": "Number of people in the party",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 4
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Only slots that start after this date-time (e.g. start of the chosen day)",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2030-07-01T00:00:00.000Z"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Only slots that start before this date-time (e.g. start of the next day). Must be after from",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2030-07-02T00:00:00.000Z"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bookable slots with their free seats (empty array if none)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AvailableSlot"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },

    "/api/slots/{slot_id}": {
      "parameters": [
        {
          "name": "slot_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Get a slot with its tables (employee or warden)",
        "responses": {
          "200": {
            "description": "Slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Slot"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Slot not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "put": {
        "summary": "Modify the times and replace the whole list of tables of a slot (employee or warden)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SlotInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Slot updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Slot"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Slot not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The slot overlaps an existing slot, a removed table has reservations in the slot, the times of a slot with reservations are changed, or the slot is being modified concurrently",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "delete": {
        "summary": "Delete a slot without reservations (employee or warden)",
        "responses": {
          "204": {
            "description": "Slot deleted successfully (No Content returned)"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Slot not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The slot has reservations, or it is being modified concurrently",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/slots/{slot_id}/availability": {
      "get": {
        "summary": "check availability during a slot",
        "parameters": [
          {
            "name": "slot_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "partySize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Availability check successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "available": {
                      "type": "boolean"
                    },
                    "totalAvailableSeats": {
                      "type": "integer"
                    },
                    "availableTables": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "table_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "number": {
                            "type": "string"
                          },
                          "remainingSeats": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Insufficient seats available for this party size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No tables are assigned to this slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "description": "Requires an authenticated user."
      }
    },
    "/api/slots/{slot_id}/reservations": {
      "post": {
        "summary": "Create a new reservation for a slot",
        "parameters": [
          {
            "name": "slot_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReservationInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reservation created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "400": {
            "description": "Insufficient seats for the party size, less than 2 hours before the slot starts, or no tables assigned to the slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Slot not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The hiker already has a reservation for this slot, or the slot was being booked concurrently (retry)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "description": "Only hikers can book. The party is seated at one table if possible, otherwise over the fewest tables."
      }
    },
    "/api/reservations/{reservation_id}": {
      "parameters": [
        { "name": "reservation_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
      ],
      "get": {
        "summary": "Details of a reservation of the logged hiker",
        "description": "Only the hiker who made the reservation.",
        "responses": {
          "200": { "description": "Reservation details", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReservationDetails" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "Reservation not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "put": {
        "summary": "Change a reservation (slot, party size, requirements)",
        "description": "Only the hiker who made the reservation. Allowed up to 48 hours before the current slot starts; the new slot must start at least 2 hours from now (same rule as booking). The booking reference does not change. Tables are kept whenever possible; they are reassigned only when the slot changes or the party grows beyond the free seats of its current tables. A confirmation email is sent only if something changed.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReservationUpdateInput" } } }
        },
        "responses": {
          "200": { "description": "Reservation updated (or unchanged, see 'changed')", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReservationUpdateResult" } } } },
          "400": { "description": "Less than 48 hours before the current slot, new slot starting in less than 2 hours, insufficient seats, or no tables assigned to the new slot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "description": "Reservation or slot not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "The hiker already has a reservation for the new slot, or the slot was being booked concurrently (retry)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    }

  },
  "components": {
    "schemas": {
      "SignupInput": {
        "type": "object",
        "required": [
          "name",
          "surname",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50,
            "example": "Anna"
          },
          "surname": {
            "type": "string",
            "maxLength": 50,
            "example": "Bianchi"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "anna@example.com"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "+393331234567"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 256,
            "example": "Registered mountain guide"
          },
          "emergency_contact": {
            "type": "string",
            "nullable": true,
            "maxLength": 100,
            "example": "Mario Rossi - +391234567890"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 128,
            "example": "password123"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "warden@rifugio.it"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "Password123!"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "anna@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "hiker",
              "employee",
              "warden"
            ],
            "example": "hiker"
          }
        }
      },
      "TableInput": {
        "type": "object",
        "required": [
          "number",
          "seats"
        ],
        "properties": {
          "number": {
            "type": "string",
            "example": "T1"
          },
          "seats": {
            "type": "integer",
            "example": 4
          }
        }
      },
      "ReservationInput": {
        "type": "object",
        "required": [
          "people"
        ],
        "properties": {
          "people": {
            "type": "integer",
            "example": 4
          }
        }
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "reservation_id": {
            "type": "string",
            "format": "uuid"
          },
          "people": {
            "type": "integer",
            "example": 4
          },
          "slot_id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "table_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "number": {
                  "type": "string",
                  "example": "T1"
                },
                "seats_reserved": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "Table": {
        "type": "object",
        "properties": {
          "table_id": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "string",
            "example": "T1"
          },
          "seats": {
            "type": "integer",
            "example": 4
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Slot not found"
          }
        }
      },
      "MessageError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Unauthorized (user is not logged in)"
          }
        }
      },
      "ValidationErrors": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "people"
                },
                "message": {
                  "type": "string",
                  "example": "people must be a positive integer"
                }
              }
            }
          }
        }
      },
      "SlotInput": {
        "type": "object",
        "required": [
          "date_time_start",
          "date_time_end",
          "table_ids"
        ],
        "properties": {
          "date_time_start": {
            "type": "string",
            "format": "date-time",
            "description": "Must be in the future",
            "example": "2030-07-01T12:00:00Z"
          },
          "date_time_end": {
            "type": "string",
            "format": "date-time",
            "description": "Must be after date_time_start",
            "example": "2030-07-01T13:00:00Z"
          },
          "table_ids": {
            "type": "array",
            "description": "Tables available in the slot (duplicates are ignored)",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "Slot": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "format": "uuid"
          },
          "date_time_start": {
            "type": "string",
            "format": "date-time",
            "example": "2030-07-01T12:00:00.000Z"
          },
          "date_time_end": {
            "type": "string",
            "format": "date-time",
            "example": "2030-07-01T13:00:00.000Z"
          },
          "tables": {
            "type": "array",
            "description": "Sorted by table number",
            "items": {
              "$ref": "#/components/schemas/Table"
            }
          },
          "total_seats": {
            "type": "integer",
            "example": 6
          }
        }
      },
      "AvailableSlot": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "format": "uuid"
          },
          "date_time_start": {
            "type": "string",
            "format": "date-time",
            "example": "2030-07-01T12:00:00.000Z"
          },
          "date_time_end": {
            "type": "string",
            "format": "date-time",
            "example": "2030-07-01T13:00:00.000Z"
          },
          "free_seats": {
            "type": "integer",
            "description": "Seats still free in the slot (always >= partySize)",
            "example": 10
          }
        }
      },
      "ReservationUpdateInput": {
        "type": "object",
        "required": ["slot_id", "people", "requirements"],
        "properties": {
          "slot_id": { "type": "string", "format": "uuid" },
          "people": { "type": "integer", "minimum": 1, "example": 4 },
          "requirements": { "type": "string", "nullable": true, "maxLength": 500, "example": "One vegetarian" }
        }
      },
      "ReservationDetails": {
        "type": "object",
        "properties": {
          "reservation_id": { "type": "string", "format": "uuid" },
          "people": { "type": "integer" },
          "requirements": { "type": "string", "nullable": true },
          "slot": {
            "type": "object",
            "properties": {
              "slot_id": { "type": "string", "format": "uuid" },
              "date_time_start": { "type": "string", "format": "date-time" },
              "date_time_end": { "type": "string", "format": "date-time" }
            }
          },
          "hiker": {
            "type": "object",
            "properties": {
              "user_id": { "type": "string", "format": "uuid" },
              "name": { "type": "string" },
              "surname": { "type": "string" },
              "email": { "type": "string", "format": "email" }
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "table_id": { "type": "string", "format": "uuid" },
                "number": { "type": "string", "example": "T2" },
                "seats_reserved": { "type": "integer" }
              }
            }
          }
        }
      },
      "ReservationUpdateResult": {
        "allOf": [
          { "$ref": "#/components/schemas/ReservationDetails" },
          {
            "type": "object",
            "properties": {
              "changed": { "type": "boolean", "description": "false if the request did not change anything (no email sent)" },
              "confirmation_sent": { "type": "boolean" }
            }
          }
        ]
      }

    },
    "responses": {
      "Unauthorized": {
        "description": "Not logged in",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Logged in, but the role is not allowed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageError"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Invalid request parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrors"
            }
          }
        }
      }
    }
  }
}
